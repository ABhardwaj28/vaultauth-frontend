# VaultAuth SSO — Client Environment Variables
# In production on Render/Vercel or custom domain:
VITE_API_BASE_URL=https://api.vaultauth.proplays2312.eu.org

# Local Development fallback:
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Organisation / tenant label shown in the portal header.
# Set this when VaultAuth is onboarded as a third-party IdP for an organisation.
VITE_ORGANISATION_NAME=Organisation name
